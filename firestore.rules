     function validSource(a) { let source=get(/databases/$(database)/documents/projects/$(id)/documentReviews/$(a.sourceHash)/annotations/$(a.sourceRemarkId)).data;
      let response=/databases/$(database)/documents/projects/$(id)/feedback/$(a.sourceRemarkId)/followUp/current;
      return a.sourceHash is string && a.sourceHash.matches('[a-f0-9]{64}') && a.sourceHash != hash
       && a.sourceRemarkId is string && a.sourceRemarkId.matches('[a-zA-Z0-9_-]{1,194}') && a.sourceRootId is string && a.sourceRootId.matches('[a-zA-Z0-9_-]{1,128}')
       && a.sourceRootId == source.get('sourceRootId',a.sourceRemarkId) && aid == hash + '__' + a.sourceRootId
       && a.comment == source.comment && a.category == source.category && a.severity == source.severity && source.severity != 'Good point'
       && (!existsAfter(response) || getAfter(response).data.state != 'Addressed'); }
     function matchingFeedback(a) { let f=getAfter(/databases/$(database)/documents/projects/$(id)/feedback/$(aid)).data; return f.comment == a.comment && f.category == a.category
      && f.priority == (a.severity == 'Major correction' ? 'Action required' : a.severity == 'Good point' ? 'Positive feedback' : 'Suggestion')
      && f.actorId == a.actorId && f.actorName == a.actorName && f.createdAt == request.time && f.milestoneKey == ''
      && f.summary == 'PDF review: ' + getAfter(reviewPath()).data.fileName + ', page ' + string(a.page); }
     allow read: if access(get(projectPath(id)).data);
     allow create: if feedbackWriter(get(projectPath(id)).data) && hash.matches('[a-f0-9]{64}') && validAnchor(request.resource.data) && matchingFeedback(request.resource.data)
      && (!request.resource.data.keys().hasAny(['sourceHash','sourceRemarkId','sourceRootId']) || validSource(request.resource.data))
      && getAfter(projectPath(id)).data.lastFeedbackEventId == aid && getAfter(projectPath(id)).data.lastFeedbackBy == request.auth.uid && getAfter(projectPath(id)).data.lastFeedbackAt == request.time;
     allow update,delete: if false;
    }
   }
   match /repositoryNotices/{noticeId} {
    function noticePath() { return /databases/$(database)/documents/projects/$(id)/repositoryNotices/current; }
    function writer() { let p=get(projectPath(id)).data; return noticeId == 'current' && (hod(p.departmentId) || primary(p)) && !p.keys().hasAny(['completedDate']) && p.get('releaseState','') != 'Withheld'; }
    function validDelivery(r) { let p=get(projectPath(id)).data; let edition=get(/databases/$(database)/documents/repositoryNoticePolicies/$(p.departmentId)/history/$(r.policyRevision)).data;
     return r.keys().hasOnly(['policyRevision','policyTitle','policyBody','policyReference','deliveredOn','channel','deliveryReference','reason','confirmedWritten','revision','recordedBy','actorName','recordedAt'])
      && r.policyRevision == edition.revision && r.policyTitle == edition.title && r.policyBody == edition.body && r.policyReference == edition.reference
      && receiptDetails(r.deliveredOn,'Email','') && r.channel in ['Email','Written handbook','Printed notice','Other written notice'] && text(r.deliveryReference,500) && r.reason is string && r.reason.trim().size() > 0 && r.reason.size() <= 500 && r.confirmedWritten == true
      && text(r.revision,128) && r.recordedBy == request.auth.uid && r.actorName == get(self()).data.displayName && r.recordedAt == request.time; }
    allow read: if noticeId == 'current' && access(get(projectPath(id)).data);
    allow create,update: if writer() && validDelivery(request.resource.data)
     && (!exists(noticePath()) || request.resource.data.policyRevision != resource.data.policyRevision || request.resource.data.deliveredOn != resource.data.deliveredOn || request.resource.data.channel != resource.data.channel || request.resource.data.deliveryReference != resource.data.deliveryReference)
     && !exists(/databases/$(database)/documents/projects/$(id)/repositoryNotices/current/history/$(request.resource.data.revision))
     && getAfter(/databases/$(database)/documents/projects/$(id)/repositoryNotices/current/history/$(request.resource.data.revision)).data == request.resource.data;
    allow delete: if false;
    match /history/{eventId} {
     allow read: if noticeId == 'current' && access(get(projectPath(id)).data);
     allow create: if writer() && validDelivery(request.resource.data) && request.resource.data == getAfter(noticePath()).data && request.resource.data.revision == eventId;
     allow update,delete: if false;
    }
   }
   function receiptDetails(date,channel,note) { let parts=date.split('-'); let y=int(parts[0]); let m=int(parts[1]); let d=int(parts[2]); let days=m == 2 ? ((y % 4 == 0 && y % 100 != 0 || y % 400 == 0) ? 29 : 28) : (m in [4,6,9,11] ? 30 : 31); return y >= 1 && m >= 1 && m <= 12 && d >= 1 && d <= days && date is string && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && timestamp.date(int(parts[0]),int(parts[1]),int(parts[2])) <= request.time + duration.value(1,'h') && channel in ['Email','Drive link','Storage device','Other'] && note is string && note.size() <= 1000; }
   match /submissionRegisters/{rid} {
    function validHead(h) { let r=getAfter(/databases/$(database)/documents/projects/$(id)/submissionReceipts/$(h.latestReceiptId)).data; return h.keys().hasOnly(['latestReceiptId','version','sourceHash','actorId','updatedAt'])
     && h.latestReceiptId is string && h.latestReceiptId.matches('[a-zA-Z0-9_-]{1,128}') && !exists(/databases/$(database)/documents/projects/$(id)/submissionReceipts/$(h.latestReceiptId))
     && r.registerId == rid && r.version == h.version && r.sourceHash == h.sourceHash && r.actorId == request.auth.uid && r.createdAt == request.time
     && h.actorId == request.auth.uid && h.updatedAt == request.time; }
    allow read: if access(get(projectPath(id)).data);
    allow create: if feedbackWriter(get(projectPath(id)).data) && validHead(request.resource.data) && request.resource.data.version == 1;
    allow update: if feedbackWriter(get(projectPath(id)).data) && validHead(request.resource.data) && request.resource.data.version == resource.data.version + 1 && request.resource.data.sourceHash != resource.data.sourceHash;
    allow delete: if false;
   }
   match /submissionReceipts/{receiptId} {
    function receiptPath() { return /databases/$(database)/documents/projects/$(id)/submissionReceipts/$(receiptId); }
    function validReceipt(r) { let p=get(projectPath(id)).data; let head=/databases/$(database)/documents/projects/$(id)/submissionRegisters/$(r.registerId); return r.keys().hasOnly(['fileName','size','pages','sourceKind','sourceHash','reviewHash','milestoneKey','milestoneName','registerId','version','previousReceiptId','receivedOn','channel','note','actorId','actorName','createdAt'])
     && r.fileName is string && r.fileName.trim().size() > 0 && r.fileName.size() <= 200 && ((r.sourceKind == 'PDF' && r.fileName.lower().matches('.*\\.pdf')) || (r.sourceKind == 'Word' && r.fileName.lower().matches('.*\\.docx')))
     && r.size is int && r.size >= 1 && r.size <= 20971520 && intakeAllowed(p.departmentId,r.fileName,r.size) && r.pages is int && r.pages >= 1 && r.pages <= 100
     && r.sourceHash is string && r.sourceHash.matches('[a-f0-9]{64}') && r.reviewHash is string && r.reviewHash.matches('[a-f0-9]{64}')
     && r.milestoneKey is string && r.milestoneKey.matches('([a-zA-Z0-9_-]{1,128})?') && r.registerId == (r.milestoneKey == '' ? 'overall' : 'stage_' + r.milestoneKey)
     && (r.milestoneKey == '' ? r.milestoneName == 'Overall project' : r.milestoneKey in p.get('milestones',{}) && r.milestoneName == p.milestones[r.milestoneKey].name)
     && r.version is int && r.version >= 1 && r.version <= 1000000 && r.version == (exists(head) ? get(head).data.version + 1 : 1)
     && r.previousReceiptId == (exists(head) ? get(head).data.latestReceiptId : '') && getAfter(head).data.latestReceiptId == receiptId
     && receiptDetails(r.receivedOn,r.channel,r.note) && r.actorId == request.auth.uid && r.actorName == get(self()).data.displayName && r.createdAt == request.time; }
    function validCorrection(r) { let event=/databases/$(database)/documents/projects/$(id)/submissionReceipts/$(receiptId)/corrections/$(r.correctionRevision); let e=getAfter(event).data; return r.diff(resource.data).affectedKeys().hasOnly(['correctionRevision','correctedReceivedOn','correctedChannel','correctedNote','correctionReason','correctedBy','correctedByName','correctedAt'])
     && r.correctionRevision is string && r.correctionRevision.matches('[a-zA-Z0-9_-]{1,128}') && !exists(event) && receiptDetails(r.correctedReceivedOn,r.correctedChannel,r.correctedNote)
     && r.correctionReason is string && r.correctionReason.trim().size() > 0 && r.correctionReason.size() <= 1000 && r.correctedBy == request.auth.uid && r.correctedByName == get(self()).data.displayName && r.correctedAt == request.time
     && (r.correctedReceivedOn != resource.data.get('correctedReceivedOn',resource.data.receivedOn) || r.correctedChannel != resource.data.get('correctedChannel',resource.data.channel) || r.correctedNote != resource.data.get('correctedNote',resource.data.note))
     && e.correctionRevision == r.correctionRevision && e.correctedReceivedOn == r.correctedReceivedOn && e.correctedChannel == r.correctedChannel && e.correctedNote == r.correctedNote && e.correctionReason == r.correctionReason && e.correctedBy == r.correctedBy && e.correctedByName == r.correctedByName && e.correctedAt == request.time
     && e.previousReceivedOn == resource.data.get('correctedReceivedOn',resource.data.receivedOn) && e.previousChannel == resource.data.get('correctedChannel',resource.data.channel) && e.previousNote == resource.data.get('correctedNote',resource.data.note); }
    allow read: if access(get(projectPath(id)).data);
    allow create: if feedbackWriter(get(projectPath(id)).data) && validReceipt(request.resource.data);
    allow update: if feedbackWriter(get(projectPath(id)).data) && validCorrection(request.resource.data);
    allow delete: if false;
    match /corrections/{cid} {
     function history(e) { let r=getAfter(receiptPath()).data; return e.keys().hasOnly(['correctionRevision','correctedReceivedOn','correctedChannel','correctedNote','correctionReason','correctedBy','correctedByName','correctedAt','previousReceivedOn','previousChannel','previousNote'])
      && r.correctionRevision == cid && e.correctionRevision == cid && e.correctedReceivedOn == r.correctedReceivedOn && e.correctedChannel == r.correctedChannel && e.correctedNote == r.correctedNote && e.correctionReason == r.correctionReason && e.correctedBy == request.auth.uid && e.correctedByName == get(self()).data.displayName && e.correctedAt == request.time; }
     allow read: if access(get(projectPath(id)).data);
     allow create: if feedbackWriter(get(projectPath(id)).data) && history(request.resource.data) && getAfter(receiptPath()).data != get(receiptPath()).data;
     allow update,delete: if false;
    }
   }
   match /submissions/{submissionId} { allow read: if access(get(projectPath(id)).data); allow write: if false; }
   match /completionHistory/{eventId} {
    allow read: if access(get(projectPath(id)).data);
    allow create: if completionActor(get(projectPath(id)).data) && request.resource.data.keys().hasOnly(['date','note','archiveId','actorId','actorName','createdAt','archiveConsentConfirmed'])
     && getAfter(projectPath(id)).data.lastCompletionEventId == eventId && request.resource.data.date == getAfter(projectPath(id)).data.completedDate && request.resource.data.note == getAfter(projectPath(id)).data.completionNote && request.resource.data.archiveId == getAfter(projectPath(id)).data.archiveId
     && request.resource.data.actorId == request.auth.uid && request.resource.data.actorName == get(self()).data.displayName && request.resource.data.createdAt == request.time && request.resource.data.archiveConsentConfirmed == true;
    allow update,delete: if false;
   }
   match /defenceHistory/{eventId} {
    allow read: if access(get(projectPath(id)).data);
    allow create: if primary(get(projectPath(id)).data) && request.resource.data.keys().hasOnly(['cleared','previousCleared','note','override','actorId','actorName','createdAt'])
     && getAfter(projectPath(id)).data.lastDefenceEventId == eventId && request.resource.data.cleared == getAfter(projectPath(id)).data.defenceCleared && request.resource.data.previousCleared == get(projectPath(id)).data.get('defenceCleared',false)
     && request.resource.data.note == getAfter(projectPath(id)).data.defenceNote && request.resource.data.override == getAfter(projectPath(id)).data.defenceOverride
     && request.resource.data.actorId == request.auth.uid && request.resource.data.actorName == get(self()).data.displayName && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
   match /topicHistory/{eventId} {
    allow read: if access(get(projectPath(id)).data);
    allow create: if primary(get(projectPath(id)).data) && request.resource.data.keys().hasOnly(['title','abstract','decision','note','previousDecision','actorId','actorName','createdAt'])
     && getAfter(projectPath(id)).data.lastTopicEventId == eventId && request.resource.data.title == getAfter(projectPath(id)).data.title
     && request.resource.data.abstract == getAfter(projectPath(id)).data.abstract && request.resource.data.decision == getAfter(projectPath(id)).data.topicDecision && request.resource.data.note == getAfter(projectPath(id)).data.decisionNote
     && request.resource.data.previousDecision == get(projectPath(id)).data.get('topicDecision','Awaiting topic') && request.resource.data.actorId == request.auth.uid && request.resource.data.actorName == get(self()).data.displayName && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
   match /progressHistory/{eventId} {
    allow read: if access(get(projectPath(id)).data);
    allow create: if primary(get(projectPath(id)).data) && request.resource.data.keys().hasOnly(['milestoneKey','previous','current','actorId','actorName','createdAt'])
     && getAfter(projectPath(id)).data.lastProgressEventId == eventId && request.resource.data.milestoneKey == getAfter(projectPath(id)).data.lastMilestoneKey
     && request.resource.data.previous == get(projectPath(id)).data.milestones[request.resource.data.milestoneKey] && request.resource.data.current == getAfter(projectPath(id)).data.milestones[request.resource.data.milestoneKey]
     && request.resource.data.actorId == request.auth.uid && request.resource.data.actorName == get(self()).data.displayName && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
  }
  match /chats/{cid} {
   allow get: if (active() && role() in ['hod','lecturer'] && !exists(/databases/$(database)/documents/chats/$(cid))) || chatAccess(resource.data);
   allow list: if chatAccess(resource.data);
   allow create: if chatStaff(request.resource.data.departmentId)
    && request.resource.data.keys().hasOnly(['departmentId','kind','name','memberIds','createdBy','createdAt'])
    && text(request.resource.data.name,100) && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
    && ((request.resource.data.kind == 'general' && cid == 'general__'+request.resource.data.departmentId && request.resource.data.memberIds == [])
     || (request.resource.data.kind in ['direct','group'] && validChatMembers(request.resource.data.memberIds,request.resource.data.departmentId) && (request.resource.data.kind != 'direct' || request.resource.data.memberIds.size() == 2)));
   allow update,delete: if false;
   match /messages/{mid} {
    function parent() { return get(/databases/$(database)/documents/chats/$(cid)).data; }
    function moderatedRemoval() { let rid=request.resource.data.moderationReportId; let path=/databases/$(database)/documents/chatReports/$(rid); let before=get(path).data; let after=getAfter(path).data;
     return active() && role() == 'admin' && rid is string && rid.matches('[a-zA-Z0-9_-]{1,128}') && before.targetRole == 'admin' && before.state == 'Under review'
      && before.chatId == cid && before.messageId == mid && before.departmentId == parent().departmentId && before.senderId == resource.data.senderId && before.senderName == resource.data.senderName
      && before.messageBody == resource.data.body && before.messageCreatedAt == resource.data.createdAt && before.messageUpdatedAt == resource.data.updatedAt && resource.data.removed == false
      && after.state == 'Message removed' && after.updatedBy == request.auth.uid && after.updatedAt == request.time && after.revision != before.revision
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','removed','updatedAt','moderationReportId']) && request.resource.data.body == '' && request.resource.data.removed == true && request.resource.data.updatedAt == request.time; }
    function validMessage(m) { return m.body is string && m.body.size() <= 4000 && m.removed is bool && m.announcement is bool && (m.removed ? m.body == '' : m.body.trim().size() > 0) && (!m.announcement || (role() == 'hod' && parent().kind == 'general')); }
    function validReply(m) { let rid=m.get('replyToId',''); return rid == '' || (rid is string && rid.matches('[a-zA-Z0-9_-]{1,128}') && rid != mid && m.announcement == false
     && getAfter(/databases/$(database)/documents/chats/$(cid)/messages/$(rid)).data.removed == false
     && get(/databases/$(database)/documents/chats/$(cid)/messages/$(rid)).data.get('replyToId','') == ''); }
    allow read: if chatAccess(parent());
    allow create: if chatAccess(parent()) && request.resource.data.keys().hasOnly(['body','senderId','senderName','removed','announcement','projectRefId','replyToId','createdAt','updatedAt']) && validReply(request.resource.data)
     && request.resource.data.senderId == request.auth.uid && request.resource.data.senderName == get(self()).data.displayName && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time && request.resource.data.removed == false && validMessage(request.resource.data)
     && (request.resource.data.get('projectRefId','') == '' || (request.resource.data.projectRefId == mid && getAfter(/databases/$(database)/documents/chats/$(cid)/projectReferences/$(mid)).data.createdBy == request.auth.uid));
    allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderationReportId']) ? moderatedRemoval() : (chatAccess(parent()) && resource.data.senderId == request.auth.uid && resource.data.removed == false
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','removed','updatedAt']) && request.resource.data.updatedAt == request.time && validMessage(request.resource.data));
    allow delete: if false;
   }
   match /projectReferences/{mid} {
    function parentChat() { return get(/databases/$(database)/documents/chats/$(cid)).data; }
    allow get: if chatAccess(parentChat()) && access(get(projectPath(resource.data.projectId)).data);
    allow list,update,delete: if false;
    allow create: if chatAccess(parentChat()) && request.resource.data.keys().hasOnly(['projectId','createdBy','createdAt'])
     && request.resource.data.projectId is string && access(get(projectPath(request.resource.data.projectId)).data)
     && get(projectPath(request.resource.data.projectId)).data.departmentId == parentChat().departmentId
     && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
     && getAfter(/databases/$(database)/documents/chats/$(cid)/messages/$(mid)).data.projectRefId == mid
     && getAfter(/databases/$(database)/documents/chats/$(cid)/messages/$(mid)).data.senderId == request.auth.uid
     && getAfter(/databases/$(database)/documents/chats/$(cid)/messages/$(mid)).data.createdAt == request.time;
   }
   match /openStates/{uid} {
    function directAccess() { let c=get(/databases/$(database)/documents/chats/$(cid)).data; return c.kind == 'direct' && uid in c.memberIds && chatAccess(c); }
    allow get: if directAccess();
    allow list: if false;
    allow create,update: if directAccess() && uid == request.auth.uid
     && request.resource.data.keys().hasOnly(['throughMessageId','throughCreatedAt'])
     && request.resource.data.throughMessageId is string && request.resource.data.throughMessageId.matches('[a-zA-Z0-9_-]{1,128}')
     && request.resource.data.throughCreatedAt is timestamp && request.resource.data.throughCreatedAt <= request.time
     && request.resource.data.throughCreatedAt == get(/databases/$(database)/documents/chats/$(cid)/messages/$(request.resource.data.throughMessageId)).data.createdAt
     && (!exists(/databases/$(database)/documents/chats/$(cid)/openStates/$(uid)) || request.resource.data.throughCreatedAt >= resource.data.throughCreatedAt);
    allow delete: if directAccess() && uid == request.auth.uid;
   }
   match /readStates/{uid} {
    allow get: if chatAccess(get(/databases/$(database)/documents/chats/$(cid)).data) && uid == request.auth.uid;
    allow list,delete: if false;
    allow create,update: if chatAccess(get(/databases/$(database)/documents/chats/$(cid)).data) && uid == request.auth.uid
     && request.resource.data.keys().hasOnly(['lastReadAt','muted']) && request.resource.data.muted is bool && request.resource.data.lastReadAt is timestamp && request.resource.data.lastReadAt <= request.time
     && (!exists(/databases/$(database)/documents/chats/$(cid)/readStates/$(uid)) || request.resource.data.lastReadAt >= resource.data.lastReadAt);
   }
  }
  match /notificationReceipts/{uid}/items/{nid} {
   allow read: if active() && role() in ['hod','lecturer'] && uid == request.auth.uid;
   allow create,update: if active() && role() in ['hod','lecturer'] && uid == request.auth.uid
    && nid.matches('[a-f0-9]{64}') && request.resource.data.keys().hasOnly(['seenAt']) && request.resource.data.seenAt == request.time;
   allow delete: if false;
  }
  match /{document=**} { allow read,write: if false; }
 }
}

