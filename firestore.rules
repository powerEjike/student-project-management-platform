rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function self() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
  function active() { return signedIn() && exists(self()) && get(self()).data.active == true && get(self()).data.role in ['admin','hod','lecturer']; }
  function role() { return get(self()).data.role; }
  function same(id) { return active() && get(self()).data.departmentId == id; }
  function hod(id) { return same(id) && role() == 'hod'; }
  function text(v,max) { return v is string && v.size() > 0 && v.size() <= max && v.matches('.*[^ ].*'); }
  function titleKey(value) { return value.replace('[^\\p{L}\\p{N}\\s]','').replace('\\s+',' ').trim(); }
  function projectPath(id) { return /databases/$(database)/documents/projects/$(id); }
  function studentPath(id) { return /databases/$(database)/documents/students/$(id); }
  function staffPath(id) { return /databases/$(database)/documents/staff/$(id); }
  function primary(p) { let staff=get(self()).data; return signedIn() && staff.active == true && staff.role == 'lecturer' && staff.departmentId == p.departmentId && p.supervisorId == request.auth.uid; }
  function stepValue(s) { let days=s.days; let name=s.name; return s == {'name':name,'days':days} && text(name,100) && days is int && days >= 0 && days <= 730; }
  function step(steps,i) { return steps.size() <= i || stepValue(steps[i]); }
  function validSteps(steps) { return steps is list && steps.size() >= 1 && steps.size() <= 10 && step(steps,0) && step(steps,1) && step(steps,2) && step(steps,3) && step(steps,4) && step(steps,5) && step(steps,6) && step(steps,7) && step(steps,8) && step(steps,9); }
  function validMilestone(m) { return m.keys().hasOnly(['name','dueDate','status','note']) && text(m.name,100) && m.dueDate is string && m.dueDate.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') && m.status in ['Not started','In progress','Under review','Completed','Delayed'] && m.note is string && m.note.size() <= 2000; }
  function initialValue(m,name) { return m == {'name':name,'dueDate':m.dueDate,'status':'Not started','note':''} && m.dueDate.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'); }
  function initialStep(p,i) { return p.milestonePlan.size() <= i || initialValue(p.milestones['m'+string(i)],p.milestonePlan[i].name); }
  function initialMilestones(p) { return p.milestones is map && p.milestones.size() == p.milestonePlan.size() && initialStep(p,0) && initialStep(p,1) && initialStep(p,2) && initialStep(p,3) && initialStep(p,4) && initialStep(p,5) && initialStep(p,6) && initialStep(p,7) && initialStep(p,8) && initialStep(p,9); }
  function topicChange(id) {
   let p=request.resource.data;
   let e=getAfter(/databases/$(database)/documents/projects/$(id)/topicHistory/$(p.lastTopicEventId)).data;
   return resource.data.get('releaseState','') != 'Withheld' && primary(resource.data) && resource.data.get('topicDecision','Awaiting topic') != 'Approved'
    && p.diff(resource.data).affectedKeys().hasOnly(['title','abstract','topicDecision','decisionNote','topicApprovedBy','topicApprovedAt','templateId','milestonePlan','milestones','status','updatedBy','updatedAt','lastSupervisorUpdateAt','lastTopicEventId'])
    && text(p.title,300) && text(p.abstract,3000) && p.topicDecision in ['Approved','Rejected','Changes requested'] && p.decisionNote is string && p.decisionNote.size() <= 2000 && (p.topicDecision == 'Approved' || text(p.decisionNote,2000))
    && p.updatedBy == request.auth.uid && p.updatedAt == request.time && p.lastSupervisorUpdateAt == request.time && text(p.lastTopicEventId,128) && e.actorId == request.auth.uid && e.createdAt == request.time
    && ((p.topicDecision == 'Approved' && p.status == 'Research in progress' && p.topicApprovedBy == request.auth.uid && p.topicApprovedAt == request.time
      && p.templateId == resource.data.departmentId + '__' + get(studentPath(id)).data.programme.upper().replace('[^A-Z0-9]','')
      && p.milestonePlan == get(/databases/$(database)/documents/milestoneTemplates/$(p.templateId)).data.steps && initialMilestones(p))
      || (p.topicDecision != 'Approved' && p.status == p.topicDecision && p.topicApprovedBy == '' && p.topicApprovedAt == null && p.templateId == '' && p.milestonePlan == [] && p.milestones == {}));
  }
  function progressChange(id) {
   let p=request.resource.data;
   let key=p.lastMilestoneKey;
   let e=getAfter(/databases/$(database)/documents/projects/$(id)/progressHistory/$(p.lastProgressEventId)).data;
   return resource.data.get('releaseState','') != 'Withheld' && primary(resource.data) && resource.data.topicDecision == 'Approved'
    && p.diff(resource.data).affectedKeys().hasOnly(['milestones','lastMilestoneKey','lastProgressEventId','lastSupervisorUpdateAt','updatedBy','updatedAt'])
    && key in resource.data.milestones && p.milestones.diff(resource.data.milestones).affectedKeys().hasOnly([key]) && p.milestones.size() == resource.data.milestones.size()
    && validMilestone(p.milestones[key]) && p.milestones[key].name == resource.data.milestones[key].name
    && p.updatedBy == request.auth.uid && p.updatedAt == request.time && p.lastSupervisorUpdateAt == request.time && text(p.lastProgressEventId,128) && e.actorId == request.auth.uid && e.createdAt == request.time;
  }
  function defenceChange(id) { let p=request.resource.data; let e=getAfter(/databases/$(database)/documents/projects/$(id)/defenceHistory/$(p.lastDefenceEventId)).data;
   return resource.data.get('releaseState','') != 'Withheld' && primary(resource.data) && p.diff(resource.data).affectedKeys().hasOnly(['defenceCleared','defenceDate','defenceBy','defenceByName','defenceNote','defenceOverride','lastDefenceEventId','updatedBy','updatedAt'])
    && p.defenceCleared is bool && p.defenceCleared != resource.data.get('defenceCleared',false)
    && p.defenceBy == request.auth.uid && p.defenceByName == get(self()).data.displayName && p.updatedBy == request.auth.uid && p.updatedAt == request.time
    && p.defenceNote is string && p.defenceNote.size() <= 2000 && p.defenceOverride is string && p.defenceOverride.size() <= 2000
    && ((p.defenceCleared && resource.data.topicDecision == 'Approved' && p.defenceDate == request.time && text(p.defenceOverride,2000)) || (!p.defenceCleared && p.defenceDate == null && p.defenceOverride == '' && text(p.defenceNote,2000)))
    && text(p.lastDefenceEventId,128) && e.actorId == request.auth.uid && e.createdAt == request.time;
  }
  function completionActor(p) { return hod(p.departmentId) || primary(p); }
  function completedArchive(id) { let a=request.resource.data; let p=getAfter(projectPath(a.sourceProjectId)).data; let s=get(studentPath(a.sourceProjectId)).data;
   return completionActor(get(projectPath(a.sourceProjectId)).data) && !get(projectPath(a.sourceProjectId)).data.keys().hasAny(['completedDate']) && p.status == 'Completed' && p.archiveId == id
    && a.departmentId == p.departmentId && a.title == p.title && a.author == s.name && a.programme == s.programme && p.completedDate.matches(string(a.year)+'-[0-9]{2}-[0-9]{2}');
  }
  function completionChange(id) { let p=request.resource.data; let e=getAfter(/databases/$(database)/documents/projects/$(id)/completionHistory/$(p.lastCompletionEventId)).data; let a=getAfter(/databases/$(database)/documents/archive/$(p.archiveId)).data; let parts=p.completedDate.split('-');
   return !(resource.data.get('releaseState','') in ['Pending','Withheld']) && completionActor(resource.data) && !resource.data.keys().hasAny(['completedDate']) && resource.data.defenceCleared == true && resource.data.topicDecision == 'Approved'
    && p.diff(resource.data).affectedKeys().hasOnly(['status','completedDate','completedBy','completedByName','completionNote','archiveId','lastCompletionEventId','updatedBy','updatedAt'])
    && p.status == 'Completed' && p.completedDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && timestamp.date(int(parts[0]),int(parts[1]),int(parts[2])) <= request.time + duration.value(1,'h')
    && p.completedBy == request.auth.uid && p.completedByName == get(self()).data.displayName && p.completionNote is string && p.completionNote.size() <= 2000
    && p.updatedBy == request.auth.uid && p.updatedAt == request.time && p.archiveId.matches('[a-f0-9]{64}') && text(p.lastCompletionEventId,128)
    && a.sourceProjectId == id && a.createdBy == request.auth.uid && a.createdAt == request.time && e.actorId == request.auth.uid && e.createdAt == request.time;
  }
  function access(p) { return active() && role() != 'admin' && same(p.departmentId) && (role() == 'hod' || p.supervisorId == request.auth.uid || p.get('coSupervisorId','') == request.auth.uid); }
  function hodStudent(id) { return active() && role() == 'hod' && exists(studentPath(id)) && hod(get(studentPath(id)).data.departmentId); }
  function lecturer(id,departmentId) { return exists(staffPath(id)) && get(staffPath(id)).data.active == true && get(staffPath(id)).data.role == 'lecturer' && get(staffPath(id)).data.departmentId == departmentId; }
  function allocation(p) {
   return p.supervisorId is string && p.coSupervisorId is string && p.supervisorId != p.coSupervisorId
    && lecturer(p.supervisorId,p.departmentId) && p.supervisorName == get(staffPath(p.supervisorId)).data.displayName
    && ((p.coSupervisorId == '' && p.coSupervisorName == '') || (lecturer(p.coSupervisorId,p.departmentId) && p.coSupervisorName == get(staffPath(p.coSupervisorId)).data.displayName))
    && p.updatedBy == request.auth.uid && p.updatedAt == request.time && text(p.lastAllocationEventId,128);
  }
  function event(id,p) {
   let e = getAfter(/databases/$(database)/documents/projects/$(id)/allocations/$(p.lastAllocationEventId)).data;
   return e.actorId == request.auth.uid && e.createdAt == request.time && e.supervisorId == p.supervisorId && e.coSupervisorId == p.coSupervisorId;
  }

  function releaseNote(v) { return v is string && v.size() <= 2000 && v.trim().size() > 0; }

  function contactSummaryPath(id) { return /databases/$(database)/documents/projects/$(id)/contactSummary/current; }
  function contactPrivate(id) { let p=get(projectPath(id)).data; return hod(p.departmentId) || primary(p); }
  function contactWriter(id) { let p=get(projectPath(id)).data; return primary(p) && !p.keys().hasAny(['completedDate']) && p.get('releaseState','') != 'Withheld'; }
  function validContact(c) { let parts=c.date.split('-'); return c.keys().hasOnly(['date','channel','outcome','note','agreedActions','actorId','actorName','createdAt']) && c.date is string && c.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && timestamp.date(int(parts[0]),int(parts[1]),int(parts[2])) <= request.time + duration.value(1,'h') && c.channel in ['Meeting','Phone','Email','WhatsApp','Other'] && c.outcome in ['Contacted','No response','Cancelled'] && releaseNote(c.note) && c.get('agreedActions','') is string && c.get('agreedActions','').size() <= 2000 && (c.outcome == 'Contacted' || c.get('agreedActions','') == '') && c.actorId == request.auth.uid && c.actorName == get(self()).data.displayName && c.createdAt == request.time; }
  function contactEvidence(id,a) { let p=get(projectPath(id)).data; let path=contactSummaryPath(id); let base={'milestones':p.get('milestones',{}),'lastProjectUpdate':p.get('updatedAt',null),'uploadEvidence':'Uploads disabled'}; return (!exists(path) && a == {'milestones':base.milestones,'lastProjectUpdate':base.lastProjectUpdate,'uploadEvidence':base.uploadEvidence,'contactEvidence':'Not recorded'}) || (a.keys().hasOnly(['milestones','lastProjectUpdate','uploadEvidence','contacts']) && a.diff(base).affectedKeys().hasOnly(['contacts']) && a.contacts == (exists(path) ? get(path).data : {})); }
  function releasePath(id) { return /databases/$(database)/documents/releaseRequests/$(id); }
  function releaseChange(id) { let p=request.resource.data; let before=resource.data; let r=getAfter(releasePath(p.releaseRequestId)).data;
   return !before.keys().hasAny(['completedDate']) && r.projectId == id && r.departmentId == p.departmentId && r.updatedAt == request.time && r.updatedBy == request.auth.uid && p.updatedAt == request.time && p.updatedBy == request.auth.uid
    && ((primary(before) && !(before.get('releaseState','') in ['Pending','Withheld']) && p.releaseState == 'Pending' && r.state == 'Pending' && r.supervisorId == request.auth.uid && r.createdAt == request.time && !exists(releasePath(p.releaseRequestId))
      && p.diff(before).affectedKeys().hasOnly(['releaseState','releaseRequestId','updatedAt','updatedBy']))
     || (hod(p.departmentId) && p.releaseRequestId == before.releaseRequestId && p.releaseState == r.state
      && ((before.releaseState == 'Pending' && r.state in ['Declined','Reassigned','Withheld']) || (before.releaseState == 'Withheld' && r.state == 'Reinstated'))
      && ((r.state in ['Reassigned','Reinstated'] && p.diff(before).affectedKeys().hasOnly(['releaseState','supervisorId','supervisorName','coSupervisorId','coSupervisorName','lastAllocationEventId','updatedAt','updatedBy']) && p.coSupervisorId == '' && allocation(p) && event(id,p) && (r.state == 'Reinstated' || p.supervisorId != r.supervisorId))
       || (r.state in ['Declined','Withheld'] && p.diff(before).affectedKeys().hasOnly(['releaseState','updatedAt','updatedBy'])))));
  }
  match /releaseRequests/{rid} {
   function visible(r) { return hod(r.departmentId) || (same(r.departmentId) && role() == 'lecturer' && r.supervisorId == request.auth.uid); }
   function audit(r) { let h=getAfter(/databases/$(database)/documents/releaseRequests/$(rid)/history/$(r.lastEventId)).data; return text(r.lastEventId,128) && r.updatedBy == request.auth.uid && r.updatedAt == request.time && h.state == r.state && h.actorId == request.auth.uid && h.createdAt == request.time; }
   allow read: if visible(resource.data);
   allow create: if request.resource.data.keys().hasOnly(['studentName','projectId','departmentId','supervisorId','reason','note','state','decisionNote','activity','createdAt','updatedAt','updatedBy','lastEventId'])
    && request.resource.data.studentName == get(studentPath(request.resource.data.projectId)).data.get('name','')
    && primary(get(projectPath(request.resource.data.projectId)).data) && request.resource.data.supervisorId == request.auth.uid && request.resource.data.departmentId == get(projectPath(request.resource.data.projectId)).data.departmentId
    && request.resource.data.reason in ['Non-responsive','Not serious about the work','Other'] && releaseNote(request.resource.data.note) && request.resource.data.state == 'Pending' && request.resource.data.decisionNote == '' && request.resource.data.createdAt == request.time
    && contactEvidence(request.resource.data.projectId,request.resource.data.activity)
    && getAfter(projectPath(request.resource.data.projectId)).data.releaseRequestId == rid && getAfter(projectPath(request.resource.data.projectId)).data.releaseState == 'Pending' && audit(request.resource.data);
   allow update: if hod(resource.data.departmentId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','decisionNote','updatedBy','updatedAt','lastEventId']) && releaseNote(request.resource.data.decisionNote)
    && ((resource.data.state == 'Pending' && request.resource.data.state in ['Declined','Reassigned','Withheld']) || (resource.data.state == 'Withheld' && request.resource.data.state == 'Reinstated'))
    && getAfter(projectPath(resource.data.projectId)).data.releaseState == request.resource.data.state && getAfter(projectPath(resource.data.projectId)).data.releaseRequestId == rid && getAfter(projectPath(resource.data.projectId)).data.updatedAt == request.time && audit(request.resource.data);
   allow delete: if false;
   match /history/{hid} {
    allow read: if visible(get(releasePath(rid)).data);
    allow create: if (hod(getAfter(releasePath(rid)).data.departmentId) || primary(get(projectPath(getAfter(releasePath(rid)).data.projectId)).data))
     && request.resource.data.keys().hasOnly(['state','note','actorId','createdAt']) && getAfter(releasePath(rid)).data.lastEventId == hid && request.resource.data.state == getAfter(releasePath(rid)).data.state
     && request.resource.data.note == (request.resource.data.state == 'Pending' ? getAfter(releasePath(rid)).data.note : getAfter(releasePath(rid)).data.decisionNote)
     && request.resource.data.actorId == request.auth.uid && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
  }
  match /staff/{uid} {
   allow get: if (signedIn() && request.auth.uid == uid) || (active() && role() == 'admin') || (active() && role() == 'hod' && same(resource.data.departmentId) && resource.data.role == 'lecturer' && resource.data.active == true);
   allow list: if active() && (role() == 'admin' || (role() == 'hod' && same(resource.data.departmentId) && resource.data.role == 'lecturer' && resource.data.active == true));
   allow create,delete: if false;
   allow update: if active() && role() == 'admin' && uid != request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','active','departmentId','departmentName','updatedAt','lastAccessEventId'])
    && text(request.resource.data.lastAccessEventId,128)
    && getAfter(/databases/$(database)/documents/staffAccessChanges/$(request.resource.data.lastAccessEventId)).data.staffId == uid
    && getAfter(/databases/$(database)/documents/staffAccessChanges/$(request.resource.data.lastAccessEventId)).data.actorId == request.auth.uid
    && getAfter(/databases/$(database)/documents/staffAccessChanges/$(request.resource.data.lastAccessEventId)).data.createdAt == request.time
    && request.resource.data.role in ['admin','hod','lecturer'] && request.resource.data.active is bool && request.resource.data.updatedAt == request.time
    && ((request.resource.data.role == 'admin' && request.resource.data.departmentId == '' && request.resource.data.departmentName == '')
       || (request.resource.data.role != 'admin' && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId))
        && request.resource.data.departmentName == get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.name));
  }
  match /staffAccessChanges/{eventId} {
   allow read: if active() && role() == 'admin';
   allow create: if active() && role() == 'admin' && request.resource.data.staffId != request.auth.uid
    && request.resource.data.keys().hasOnly(['staffId','role','active','departmentId','previousRole','previousActive','previousDepartmentId','actorId','createdAt'])
    && getAfter(staffPath(request.resource.data.staffId)).data.lastAccessEventId == eventId
    && request.resource.data.role == getAfter(staffPath(request.resource.data.staffId)).data.role
    && request.resource.data.active == getAfter(staffPath(request.resource.data.staffId)).data.active
    && request.resource.data.departmentId == getAfter(staffPath(request.resource.data.staffId)).data.departmentId
    && request.resource.data.previousRole == get(staffPath(request.resource.data.staffId)).data.role
    && request.resource.data.previousActive == get(staffPath(request.resource.data.staffId)).data.active
    && request.resource.data.previousDepartmentId == get(staffPath(request.resource.data.staffId)).data.get('departmentId','')
    && request.resource.data.actorId == request.auth.uid && request.resource.data.createdAt == request.time;
   allow update,delete: if false;
  }
  match /departments/{id} {
   allow read: if active() && (role() == 'admin' || same(id));
   allow create: if active() && role() == 'admin' && id.matches('[a-z0-9-]{1,100}') && request.resource.data.keys().hasOnly(['name','createdBy','createdAt']) && text(request.resource.data.name,120) && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
   allow update: if active() && role() == 'admin' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) && text(request.resource.data.name,120);
   allow delete: if false;
  }
  match /departmentSettings/{id} {
   function manager() { return active() && (role() == 'admin' || hod(id)); }
   function settingsPath() { return /databases/$(database)/documents/departmentSettings/$(id); }
   function historyPath(event) { return /databases/$(database)/documents/departmentSettings/$(id)/history/$(event); }
   function previousLimit() { return exists(settingsPath()) ? get(settingsPath()).data.primaryLimit : 0; }
   allow get: if manager();
   allow create,update: if manager()
    && exists(/databases/$(database)/documents/departments/$(id))
    && request.resource.data.keys().hasAll(['primaryLimit','updatedBy','updatedAt','lastEventId'])
    && request.resource.data.keys().hasOnly(['primaryLimit','updatedBy','updatedAt','lastEventId'])
    && request.resource.data.primaryLimit is int && request.resource.data.primaryLimit >= 0 && request.resource.data.primaryLimit <= 1000
    && request.resource.data.primaryLimit != previousLimit()
    && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
    && text(request.resource.data.lastEventId,100) && !exists(historyPath(request.resource.data.lastEventId))
    && getAfter(historyPath(request.resource.data.lastEventId)).data.primaryLimit == request.resource.data.primaryLimit
    && getAfter(historyPath(request.resource.data.lastEventId)).data.previousLimit == previousLimit();
   allow list,delete: if false;
   match /history/{event} {
    allow read: if manager();
    allow create: if manager()
     && request.resource.data.keys().hasAll(['previousLimit','primaryLimit','actorId','actorName','createdAt'])
     && request.resource.data.keys().hasOnly(['previousLimit','primaryLimit','actorId','actorName','createdAt'])
     && getAfter(settingsPath()).data.lastEventId == event
     && getAfter(settingsPath()).data.primaryLimit == request.resource.data.primaryLimit
     && getAfter(settingsPath()).data.updatedAt == request.time && getAfter(settingsPath()).data.updatedBy == request.auth.uid
     && request.resource.data.previousLimit == previousLimit() && request.resource.data.primaryLimit != previousLimit()
     && request.resource.data.actorId == request.auth.uid && request.resource.data.actorName == get(self()).data.displayName && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
  }
  match /archive/{id} {
   allow get: if (active() && role() == 'hod' && !exists(/databases/$(database)/documents/archive/$(id))) || (active() && role() != 'admin' && same(resource.data.departmentId));
   allow list: if active() && role() != 'admin' && same(resource.data.departmentId);
   allow create: if ((request.resource.data.keys().hasAny(['sourceProjectId']) && completedArchive(id)) || (!request.resource.data.keys().hasAny(['sourceProjectId']) && hod(request.resource.data.departmentId))) && id.matches('[a-f0-9]{64}')
    && request.resource.data.keys().hasOnly(['departmentId','title','titleKey','author','year','programme','active','sourceProjectId','createdBy','createdAt','updatedBy','updatedAt','lastEventId'])
    && text(request.resource.data.title,300) && request.resource.data.titleKey.matches('[\\p{L}\\p{N} ]+') && !request.resource.data.titleKey.matches('.*\\p{Lu}.*') && titleKey(request.resource.data.title).matches('(?i)' + request.resource.data.titleKey) && text(request.resource.data.titleKey,300)
    && text(request.resource.data.author,120) && text(request.resource.data.programme,80)
    && request.resource.data.year is int && request.resource.data.year >= 1900 && request.resource.data.year <= 2100 && request.resource.data.active == true
    && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
    && archiveAudit(id);
   allow update: if hod(resource.data.departmentId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedBy','updatedAt','lastEventId'])
    && request.resource.data.active is bool && request.resource.data.active != resource.data.active && archiveAudit(id);
   allow delete: if false;
   function archiveAudit(id) { let p=request.resource.data; let e=getAfter(/databases/$(database)/documents/archive/$(id)/history/$(p.lastEventId)).data; return p.updatedBy == request.auth.uid && p.updatedAt == request.time && text(p.lastEventId,128) && e.actorId == request.auth.uid && e.recordedAt == request.time; }
   match /history/{eventId} {
    allow read: if hod(get(/databases/$(database)/documents/archive/$(id)).data.departmentId);
    allow create: if (hod(getAfter(/databases/$(database)/documents/archive/$(id)).data.departmentId) || (request.resource.data.keys().hasAny(['sourceProjectId']) && completedArchive(id)))
     && request.resource.data.keys().hasOnly(['departmentId','title','titleKey','author','year','programme','active','sourceProjectId','createdBy','createdAt','updatedBy','updatedAt','lastEventId','actorId','recordedAt','reason'])
     && request.resource.data.diff(getAfter(/databases/$(database)/documents/archive/$(id)).data).affectedKeys().hasOnly(['actorId','recordedAt','reason'])
     && request.resource.data.lastEventId == eventId && request.resource.data.actorId == request.auth.uid && request.resource.data.recordedAt == request.time && text(request.resource.data.reason,500);
    allow update,delete: if false;
   }
  }
  match /milestoneTemplates/{id} {
   allow get: if active() && (role() == 'admin' || id.matches(get(self()).data.departmentId + '__[A-Z0-9]+'));
   allow list: if active() && (role() == 'admin' || same(resource.data.departmentId));
   allow create,update: if active() && role() == 'admin'
    && request.resource.data.keys().hasOnly(['departmentId','programme','programmeKey','steps','updatedBy','updatedAt','lastEventId'])
    && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId))
    && text(request.resource.data.programme,80) && request.resource.data.programmeKey == request.resource.data.programme.upper().replace('[^A-Z0-9]','') && text(request.resource.data.programmeKey,80)
    && id == request.resource.data.departmentId + '__' + request.resource.data.programmeKey && validSteps(request.resource.data.steps)
    && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && text(request.resource.data.lastEventId,128)
    && getAfter(/databases/$(database)/documents/milestoneTemplates/$(id)/history/$(request.resource.data.lastEventId)).data.steps == request.resource.data.steps
    && getAfter(/databases/$(database)/documents/milestoneTemplates/$(id)/history/$(request.resource.data.lastEventId)).data.actorId == request.auth.uid
    && getAfter(/databases/$(database)/documents/milestoneTemplates/$(id)/history/$(request.resource.data.lastEventId)).data.createdAt == request.time;
   allow delete: if false;
   match /history/{eventId} {
    allow read: if active() && role() == 'admin';
    allow create: if active() && role() == 'admin' && request.resource.data.keys().hasOnly(['departmentId','programme','programmeKey','steps','updatedBy','updatedAt','lastEventId','actorId','createdAt'])
     && request.resource.data.diff(getAfter(/databases/$(database)/documents/milestoneTemplates/$(id)).data).affectedKeys().hasOnly(['actorId','createdAt'])
     && getAfter(/databases/$(database)/documents/milestoneTemplates/$(id)).data.lastEventId == eventId && request.resource.data.actorId == request.auth.uid && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
  }
  function lecturerNew(id) { let p=getAfter(projectPath(id)).data; let s=getAfter(studentPath(id)).data; return !exists(projectPath(id)) && primary(p) && s.departmentId == get(self()).data.departmentId && s.departmentId == p.departmentId && s.createdBy == request.auth.uid && s.createdAt == request.time && p.coSupervisorId == '' && p.createdBy == request.auth.uid && p.createdAt == request.time; }
  match /rosterImports/{id} {
   allow read: if active() && (role() == 'admin' || hod(resource.data.departmentId));
   allow create: if active() && role() == 'admin' && request.resource.data.keys().hasOnly(['departmentId','session','admissionSession','added','skipped','actorId','createdAt'])
    && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)) && text(request.resource.data.session,80) && text(request.resource.data.admissionSession,80)
    && request.resource.data.added is int && request.resource.data.added > 0 && request.resource.data.added <= 10 && request.resource.data.skipped is int && request.resource.data.skipped >= 0 && request.resource.data.skipped <= 10
    && request.resource.data.actorId == request.auth.uid && request.resource.data.createdAt == request.time;
   allow update,delete: if false;
  }
  match /students/{id} {
   allow get: if (active() && role() == 'admin') || (active() && role() == 'lecturer' && !exists(studentPath(id))) || (active() && role() == 'hod' && (!exists(studentPath(id)) || hod(resource.data.departmentId))) || (exists(projectPath(id)) && access(get(projectPath(id)).data));
   allow list: if (active() && role() == 'admin') || hod(resource.data.departmentId);
   allow create: if ((active() && role() == 'admin') || hod(request.resource.data.departmentId) || lecturerNew(id)) && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId))
    && request.resource.data.keys().hasOnly(['departmentId','name','matricNumber','matricKey','programme','level','session','email','admissionSession','currentCGPA','gender','createdBy','createdAt'])
    && text(request.resource.data.name,120) && text(request.resource.data.matricNumber,80) && text(request.resource.data.programme,80) && text(request.resource.data.level,80) && text(request.resource.data.session,80)
    && (!request.resource.data.keys().hasAny(['admissionSession']) || (request.resource.data.admissionSession is string && request.resource.data.admissionSession.matches('[0-9]{4}/[0-9]{4}') && request.resource.data.admissionSession <= request.resource.data.session))
    && (!request.resource.data.keys().hasAny(['currentCGPA']) || (request.resource.data.currentCGPA is number && request.resource.data.currentCGPA >= 0 && request.resource.data.currentCGPA <= 5))
    && (!request.resource.data.keys().hasAny(['gender']) || text(request.resource.data.gender,40))
    && request.resource.data.email is string && request.resource.data.email.size() <= 254
    && request.resource.data.matricKey == request.resource.data.matricNumber.upper().replace('[^A-Z0-9]','') && request.resource.data.matricKey.matches('[A-Z0-9]{1,80}')
    && request.resource.data.session.upper().replace('[^A-Z0-9]','').matches('[A-Z0-9]{1,80}')
    && id == request.resource.data.departmentId + '__' + request.resource.data.session.upper().replace('[^A-Z0-9]','') + '__' + request.resource.data.matricKey
    && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
   allow update,delete: if false;
  }
  match /projects/{id} {
   allow get: if hodStudent(id) || access(resource.data);
   allow list: if access(resource.data);
   allow create: if ((hod(request.resource.data.departmentId) && hodStudent(id)) || lecturerNew(id)) && request.resource.data.studentId == id
    && request.resource.data.keys().hasOnly(['departmentId','studentId','supervisorId','coSupervisorId','supervisorName','coSupervisorName','title','status','createdBy','createdAt','updatedBy','updatedAt','lastAllocationEventId'])
    && (request.resource.data.title == '' || (lecturerNew(id) && text(request.resource.data.title,300))) && request.resource.data.status == 'Awaiting topic' && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
    && allocation(request.resource.data) && event(id,request.resource.data);
   allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasAny(['releaseState','releaseRequestId']) ? releaseChange(id) : ((!resource.data.keys().hasAny(['completedDate']) && ((!(resource.data.get('releaseState','') in ['Pending','Withheld']) && hod(resource.data.departmentId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supervisorId','coSupervisorId','supervisorName','coSupervisorName','updatedBy','updatedAt','lastAllocationEventId'])
    && (resource.data.supervisorId != request.resource.data.supervisorId || resource.data.coSupervisorId != request.resource.data.coSupervisorId)
    && allocation(request.resource.data) && event(id,request.resource.data)) || topicChange(id) || progressChange(id) || defenceChange(id))) || completionChange(id)));
   allow delete: if false;
   match /allocations/{eventId} {
    allow read: if access(get(projectPath(id)).data);
    allow create: if (hodStudent(id) || lecturerNew(id))
     && request.resource.data.keys().hasOnly(['departmentId','studentId','supervisorId','coSupervisorId','previousSupervisorId','previousCoSupervisorId','reason','actorId','createdAt'])
     && request.resource.data.departmentId == getAfter(projectPath(id)).data.departmentId && request.resource.data.studentId == id
     && request.resource.data.supervisorId == getAfter(projectPath(id)).data.supervisorId && request.resource.data.coSupervisorId == getAfter(projectPath(id)).data.coSupervisorId
     && eventId == getAfter(projectPath(id)).data.lastAllocationEventId
     && request.resource.data.previousSupervisorId == (exists(projectPath(id)) ? get(projectPath(id)).data.supervisorId : '')
     && request.resource.data.previousCoSupervisorId == (exists(projectPath(id)) ? get(projectPath(id)).data.coSupervisorId : '')
     && text(request.resource.data.reason,500) && request.resource.data.actorId == request.auth.uid && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }

   match /contacts/{cid} {
    allow read: if contactPrivate(id);
    allow create: if contactWriter(id) && validContact(request.resource.data) && getAfter(contactSummaryPath(id)).data.lastEventId == cid && getAfter(contactSummaryPath(id)).data.updatedAt == request.time;
    allow update,delete: if false;
   }
   match /contactSummary/{sid} {
    allow read: if sid == 'current' && contactPrivate(id);
    allow create,update: if sid == 'current' && contactWriter(id) && validSummary();
    allow delete: if false;
    function validSummary() { let n=request.resource.data; let b=exists(contactSummaryPath(id)) ? get(contactSummaryPath(id)).data : {'total':0,'lastMeeting':'','lastContact':'','lastAttempt':''}; let c=getAfter(/databases/$(database)/documents/projects/$(id)/contacts/$(n.lastEventId)).data;
     return n.keys().hasOnly(['total','lastMeeting','lastContact','lastAttempt','lastEventId','updatedBy','updatedAt']) && text(n.lastEventId,128) && !exists(/databases/$(database)/documents/projects/$(id)/contacts/$(n.lastEventId)) && validContact(c)
      && n.total == b.total+1 && n.lastMeeting == (c.channel == 'Meeting' && c.outcome == 'Contacted' && c.date > b.lastMeeting ? c.date : b.lastMeeting) && n.lastContact == (c.outcome == 'Contacted' && c.date > b.lastContact ? c.date : b.lastContact) && n.lastAttempt == (c.date > b.lastAttempt ? c.date : b.lastAttempt) && n.updatedBy == request.auth.uid && n.updatedAt == request.time;
    }
   }
   match /submissions/{submissionId} { allow read: if access(get(projectPath(id)).data); allow write: if false; }
   match /completionHistory/{eventId} {
    allow read: if access(get(projectPath(id)).data);
    allow create: if completionActor(get(projectPath(id)).data) && request.resource.data.keys().hasOnly(['date','note','archiveId','actorId','actorName','createdAt','archiveConsentConfirmed'])
     && getAfter(projectPath(id)).data.lastCompletionEventId == eventId && request.resource.data.date == getAfter(projectPath(id)).data.completedDate && request.resource.data.note == getAfter(projectPath(id)).data.completionNote && request.resource.data.archiveId == getAfter(projectPath(id)).data.archiveId
     && request.resource.data.actorId == request.auth.uid && request.resource.data.actorName == get(self()).data.displayName && request.resource.data.createdAt == request.time && request.resource.data.archiveConsentConfirmed == true;
    allow update,delete: if false;
   }
   match /defenceHistory/{eventId} {
    allow read: if access(get(projectPath(id)).data);
    allow create: if primary(get(projectPath(id)).data) && request.resource.data.keys().hasOnly(['cleared','previousCleared','note','override','actorId','actorName','createdAt'])
     && getAfter(projectPath(id)).data.lastDefenceEventId == eventId && request.resource.data.cleared == getAfter(projectPath(id)).data.defenceCleared && request.resource.data.previousCleared == get(projectPath(id)).data.get('defenceCleared',false)
     && request.resource.data.note == getAfter(projectPath(id)).data.defenceNote && request.resource.data.override == getAfter(projectPath(id)).data.defenceOverride
     && request.resource.data.actorId == request.auth.uid && request.resource.data.actorName == get(self()).data.displayName && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
   match /topicHistory/{eventId} {
    allow read: if access(get(projectPath(id)).data);
    allow create: if primary(get(projectPath(id)).data) && request.resource.data.keys().hasOnly(['title','abstract','decision','note','previousDecision','actorId','actorName','createdAt'])
     && getAfter(projectPath(id)).data.lastTopicEventId == eventId && request.resource.data.title == getAfter(projectPath(id)).data.title
     && request.resource.data.abstract == getAfter(projectPath(id)).data.abstract && request.resource.data.decision == getAfter(projectPath(id)).data.topicDecision && request.resource.data.note == getAfter(projectPath(id)).data.decisionNote
     && request.resource.data.previousDecision == get(projectPath(id)).data.get('topicDecision','Awaiting topic') && request.resource.data.actorId == request.auth.uid && request.resource.data.actorName == get(self()).data.displayName && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
   match /progressHistory/{eventId} {
    allow read: if access(get(projectPath(id)).data);
    allow create: if primary(get(projectPath(id)).data) && request.resource.data.keys().hasOnly(['milestoneKey','previous','current','actorId','actorName','createdAt'])
     && getAfter(projectPath(id)).data.lastProgressEventId == eventId && request.resource.data.milestoneKey == getAfter(projectPath(id)).data.lastMilestoneKey
     && request.resource.data.previous == get(projectPath(id)).data.milestones[request.resource.data.milestoneKey] && request.resource.data.current == getAfter(projectPath(id)).data.milestones[request.resource.data.milestoneKey]
     && request.resource.data.actorId == request.auth.uid && request.resource.data.actorName == get(self()).data.displayName && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
  }
  match /{document=**} { allow read,write: if false; }
 }
}

