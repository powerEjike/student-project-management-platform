rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function intakeAllowed(dept,name,size) { let path=/databases/$(database)/documents/documentIntakePolicies/$(dept); let p=exists(path) ? get(path).data : {'maxMiB':20,'pdfAllowed':true,'wordAllowed':true};
   return size <= p.maxMiB * 1048576 && ((p.pdfAllowed == true && name.lower().matches('.*\\.pdf')) || (p.wordAllowed == true && name.lower().matches('.*\\.docx'))); }
  match /documentIntakePolicies/{dept} {
   function policyPath() { return /databases/$(database)/documents/documentIntakePolicies/$(dept); }
   function previous() { return exists(policyPath()) ? get(policyPath()).data : {'maxMiB':20,'pdfAllowed':true,'wordAllowed':true}; }
   function validPolicy(r) { return r.keys().hasOnly(['maxMiB','pdfAllowed','wordAllowed','note','revision','updatedBy','updatedAt']) && r.maxMiB is int && r.maxMiB >= 1 && r.maxMiB <= 20 && r.pdfAllowed is bool && r.wordAllowed is bool && (r.pdfAllowed || r.wordAllowed)
    && r.note is string && r.note.trim().size() > 0 && r.note.size() <= 500 && text(r.revision,128) && r.updatedBy == request.auth.uid && r.updatedAt == request.time; }
   allow get: if active() && (role() == 'admin' || same(dept));
   allow list,delete: if false;
   allow create,update: if active() && role() == 'admin' && exists(/databases/$(database)/documents/departments/$(dept)) && validPolicy(request.resource.data)
    && (request.resource.data.maxMiB != previous().maxMiB || request.resource.data.pdfAllowed != previous().pdfAllowed || request.resource.data.wordAllowed != previous().wordAllowed)
    && !exists(/databases/$(database)/documents/documentIntakePolicies/$(dept)/history/$(request.resource.data.revision))
    && getAfter(/databases/$(database)/documents/documentIntakePolicies/$(dept)/history/$(request.resource.data.revision)).data.diff(request.resource.data).affectedKeys().hasOnly(['previousMaxMiB','previousPdf','previousWord','actorName']);
   match /history/{eid} {
    allow read: if active() && role() == 'admin';
    allow create: if active() && role() == 'admin' && getAfter(policyPath()).data.revision == eid && getAfter(policyPath()).data.revision != previous().get('revision','') && getAfter(policyPath()).data.updatedAt == request.time
     && request.resource.data.diff(getAfter(policyPath()).data).affectedKeys().hasOnly(['previousMaxMiB','previousPdf','previousWord','actorName'])
     && request.resource.data.previousMaxMiB == previous().maxMiB && request.resource.data.previousPdf == previous().pdfAllowed && request.resource.data.previousWord == previous().wordAllowed && request.resource.data.actorName == get(self()).data.displayName;
    allow update,delete: if false;
   }
  }
  match /repositoryNoticePolicies/{dept} {
   function manager() { return active() && (role() == 'admin' || hod(dept)); }
   function policyPath() { return /databases/$(database)/documents/repositoryNoticePolicies/$(dept); }
   function validPolicy(r) { return r.keys().hasOnly(['title','body','reference','note','revision','updatedBy','updatedAt','actorName']) && text(r.title,120) && r.body is string && r.body.trim().size() > 0 && r.body.size() <= 8000 && text(r.reference,300) && r.note is string && r.note.trim().size() > 0 && r.note.size() <= 500
    && text(r.revision,128) && r.updatedBy == request.auth.uid && r.actorName == get(self()).data.displayName && r.updatedAt == request.time; }
   allow get: if active() && (role() == 'admin' || same(dept));
   allow list,delete: if false;
   allow create,update: if manager() && exists(/databases/$(database)/documents/departments/$(dept)) && validPolicy(request.resource.data)
    && (!exists(policyPath()) || request.resource.data.title != resource.data.title || request.resource.data.body != resource.data.body || request.resource.data.reference != resource.data.reference)
    && !exists(/databases/$(database)/documents/repositoryNoticePolicies/$(dept)/history/$(request.resource.data.revision))
    && getAfter(/databases/$(database)/documents/repositoryNoticePolicies/$(dept)/history/$(request.resource.data.revision)).data == request.resource.data;
   match /history/{editionId} {
    allow read: if active() && (role() == 'admin' || same(dept));
    allow create: if manager() && validPolicy(request.resource.data) && request.resource.data == getAfter(policyPath()).data && request.resource.data.revision == editionId;
    allow update,delete: if false;
   }
  }
  function allocationRole(primaryId,coId,uid) { return primaryId == uid ? 'Primary supervisor' : (coId == uid ? 'Co-supervisor' : 'Not assigned'); }
  match /allocationSignals/{eventId} {
   function validSignal(s) { let p=getAfter(projectPath(s.projectId)).data; let path=/databases/$(database)/documents/projects/$(s.projectId)/allocations/$(eventId); let e=getAfter(path).data; return s.keys().hasOnly(['projectId','departmentId','createdBy','createdAt'])
    && chatStaff(s.departmentId) && p.departmentId == s.departmentId && p.lastAllocationEventId == eventId && !exists(path)
    && e.departmentId == s.departmentId && e.actorId == request.auth.uid && e.createdAt == request.time && s.createdBy == request.auth.uid && s.createdAt == request.time; }
   allow create: if active() && validSignal(request.resource.data);
   allow read,update,delete: if false;
  }
  match /allocationUpdates/{uid}/changes/{eventId} {
   function validUpdate(r) { let path=/databases/$(database)/documents/allocationSignals/$(eventId); let s=getAfter(path).data; let e=getAfter(/databases/$(database)/documents/projects/$(s.projectId)/allocations/$(eventId)).data; return r.keys().hasOnly(['departmentId','previousRole','newRole','createdAt'])
    && !exists(path) && s.createdBy == request.auth.uid && s.createdAt == request.time && r.departmentId == s.departmentId && chatStaff(s.departmentId)
    && r.previousRole == allocationRole(e.previousSupervisorId,e.previousCoSupervisorId,uid) && r.newRole == allocationRole(e.supervisorId,e.coSupervisorId,uid) && r.previousRole != r.newRole && r.createdAt == request.time; }
   allow read: if signedIn() && request.auth.uid == uid && chatStaff(resource.data.departmentId);
   allow create: if active() && validUpdate(request.resource.data);
   allow update,delete: if false;
  }
  match /progressReminderPolicies/{dept} {
   function manager() { return active() && (role() == 'admin' || hod(dept)); }
   function policyPath() { return /databases/$(database)/documents/progressReminderPolicies/$(dept); }
   function previousReminder() { return exists(policyPath()) ? get(policyPath()).data.reminderDays : 14; }
   function previousEscalation() { return exists(policyPath()) ? get(policyPath()).data.escalationDays : 7; }
   function auditPath(eid) { return /databases/$(database)/documents/progressReminderPolicies/$(dept)/history/$(eid); }
   allow get: if active() && (role() == 'admin' || same(dept));
   allow list,delete: if false;
   allow create,update: if manager() && exists(/databases/$(database)/documents/departments/$(dept))
    && request.resource.data.keys().hasOnly(['reminderDays','escalationDays','note','revision','updatedBy','updatedAt'])
    && request.resource.data.reminderDays is int && request.resource.data.reminderDays >= 1 && request.resource.data.reminderDays <= 365
    && request.resource.data.escalationDays is int && request.resource.data.escalationDays >= 1 && request.resource.data.escalationDays <= 90
    && (request.resource.data.reminderDays != previousReminder() || request.resource.data.escalationDays != previousEscalation())
    && request.resource.data.note is string && request.resource.data.note.trim().size() > 0 && request.resource.data.note.size() <= 500
    && text(request.resource.data.revision,128) && !exists(auditPath(request.resource.data.revision))
    && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
    && getAfter(auditPath(request.resource.data.revision)).data.diff(request.resource.data).affectedKeys().hasOnly(['previousReminderDays','previousEscalationDays','actorName'])
    && getAfter(auditPath(request.resource.data.revision)).data.previousReminderDays == previousReminder() && getAfter(auditPath(request.resource.data.revision)).data.previousEscalationDays == previousEscalation()
    && getAfter(auditPath(request.resource.data.revision)).data.actorName == get(self()).data.displayName;
   match /history/{eid} {
    allow read: if manager();
    allow create: if manager() && request.resource.data.keys().hasOnly(['reminderDays','escalationDays','note','revision','updatedBy','updatedAt','previousReminderDays','previousEscalationDays','actorName'])
     && request.resource.data.diff(getAfter(policyPath()).data).affectedKeys().hasOnly(['previousReminderDays','previousEscalationDays','actorName'])
     && getAfter(policyPath()).data.revision == eid && request.resource.data.revision == eid && request.resource.data.previousReminderDays == previousReminder() && request.resource.data.previousEscalationDays == previousEscalation()
     && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && request.resource.data.actorName == get(self()).data.displayName;
    allow update,delete: if false;
   }
  }
  function reportReviewer(r) { return active() && ((role() == 'admin' && r.targetRole == 'admin') || (hod(r.departmentId) && r.targetRole == 'hod')); }
  function reportReader(r) { return reportReviewer(r) || (chatStaff(r.departmentId) && r.reporterId == request.auth.uid); }
  match /chatReports/{reportId} {
   function reportPath() { return /databases/$(database)/documents/chatReports/$(reportId); }
   function validReportAudit(r) { let e=getAfter(/databases/$(database)/documents/chatReports/$(reportId)/history/$(r.revision)).data; return r.updatedBy == request.auth.uid && r.updatedAt == request.time
    && r.revision is string && r.revision.matches('[a-zA-Z0-9_-]{1,128}') && !exists(/databases/$(database)/documents/chatReports/$(reportId)/history/$(r.revision))
    && e.state == r.state && e.targetRole == r.targetRole && e.actorId == request.auth.uid && e.actorName == get(self()).data.displayName && e.createdAt == request.time; }
   function validReport(r) { let c=get(/databases/$(database)/documents/chats/$(r.chatId)).data; let m=get(/databases/$(database)/documents/chats/$(r.chatId)/messages/$(r.messageId)).data;
    return r.keys().hasOnly(['departmentId','chatId','messageId','messageBody','senderId','senderName','messageCreatedAt','messageUpdatedAt','reporterId','reporterName','reason','hodSubject','targetRole','state','decisionNote','revision','createdAt','updatedAt','updatedBy'])
     && chatAccess(c) && r.departmentId == c.departmentId && m.removed == false && m.senderId != request.auth.uid
     && r.messageBody == m.body && r.senderId == m.senderId && r.senderName == m.senderName && r.messageCreatedAt == m.createdAt && r.messageUpdatedAt == m.updatedAt
     && r.reporterId == request.auth.uid && r.reporterName == get(self()).data.displayName && r.reason is string && r.reason.trim().size() >= 3 && r.reason.size() <= 2000
     && r.hodSubject is bool && (get(/databases/$(database)/documents/staff/$(m.senderId)).data.role != 'hod' && role() != 'hod' || r.hodSubject == true)
     && r.targetRole == (r.hodSubject ? 'admin' : 'hod') && r.state == 'Reported' && r.decisionNote == '' && r.createdAt == request.time && validReportAudit(r); }
   function removedMessage(r) { let path=/databases/$(database)/documents/chats/$(r.chatId)/messages/$(r.messageId); let m=getAfter(path).data; return role() == 'admin' && resource.data.targetRole == 'admin' && resource.data.state == 'Under review'
    && get(path).data.removed == false && m.removed == true && m.body == '' && m.moderationReportId == reportId && m.updatedAt == request.time; }
   allow read: if reportReader(resource.data);
   allow create: if active() && validReport(request.resource.data);
   allow update: if reportReviewer(resource.data) && resource.data.state != 'Message removed' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','targetRole','decisionNote','revision','updatedAt','updatedBy'])
    && request.resource.data.state in ['Under review','Closed','Escalated','Message removed'] && (request.resource.data.state != 'Message removed' || removedMessage(request.resource.data)) && request.resource.data.decisionNote is string && request.resource.data.decisionNote.trim().size() >= 3 && request.resource.data.decisionNote.size() <= 2000
    && (request.resource.data.state != resource.data.state || request.resource.data.decisionNote != resource.data.decisionNote)
    && (request.resource.data.state == 'Escalated' ? role() == 'hod' && resource.data.targetRole == 'hod' && request.resource.data.targetRole == 'admin' : request.resource.data.targetRole == resource.data.targetRole)
    && validReportAudit(request.resource.data);
   allow delete: if false;
   match /history/{eventId} {
    allow read: if reportReader(get(reportPath()).data);
    allow create: if active() && request.resource.data.keys().hasOnly(['state','targetRole','note','actorId','actorName','createdAt'])
     && (!exists(reportPath()) ? getAfter(reportPath()).data.reporterId == request.auth.uid : reportReviewer(get(reportPath()).data))
     && getAfter(reportPath()).data.revision == eventId && getAfter(reportPath()).data.updatedAt == request.time && getAfter(reportPath()).data.updatedBy == request.auth.uid
     && request.resource.data.state == getAfter(reportPath()).data.state && request.resource.data.targetRole == getAfter(reportPath()).data.targetRole
     && request.resource.data.note == (!exists(reportPath()) ? getAfter(reportPath()).data.reason : getAfter(reportPath()).data.decisionNote)
     && request.resource.data.actorId == request.auth.uid && request.resource.data.actorName == get(self()).data.displayName && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
  }
  function self() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
  function active() { return signedIn() && exists(self()) && get(self()).data.active == true && get(self()).data.role in ['admin','hod','lecturer']; }
  function role() { return get(self()).data.role; }
  function same(id) { return active() && get(self()).data.departmentId == id; }
  function hod(id) { return same(id) && role() == 'hod'; }
  function chatStaff(departmentId) { return same(departmentId) && role() in ['hod','lecturer']; }
  function chatMember(uid,departmentId) { let s=get(staffPath(uid)).data; return s.active == true && s.departmentId == departmentId && s.role in ['hod','lecturer']; }
  function chatMemberAt(ids,i,departmentId) { return ids.size() <= i || chatMember(ids[i],departmentId); }
  function validChatMembers(ids,departmentId) { return ids is list && ids.size() >= 2 && ids.size() <= 8 && ids.toSet().size() == ids.size() && request.auth.uid in ids && chatMemberAt(ids,0,departmentId) && chatMemberAt(ids,1,departmentId) && chatMemberAt(ids,2,departmentId) && chatMemberAt(ids,3,departmentId) && chatMemberAt(ids,4,departmentId) && chatMemberAt(ids,5,departmentId) && chatMemberAt(ids,6,departmentId) && chatMemberAt(ids,7,departmentId); }
  function chatAccess(c) { return chatStaff(c.departmentId) && (c.kind == 'general' || request.auth.uid in c.memberIds); }
  function text(v,max) { return v is string && v.size() > 0 && v.size() <= max && v.matches('.*[^ ].*'); }
  function titleKey(value) { return value.replace('[^\\p{L}\\p{N}\\s]','').replace('\\s+',' ').trim(); }
  function projectPath(id) { return /databases/$(database)/documents/projects/$(id); }
  function studentPath(id) { return /databases/$(database)/documents/students/$(id); }
  function staffPath(id) { return /databases/$(database)/documents/staff/$(id); }
  function primary(p) { let staff=get(self()).data; return signedIn() && staff.active == true && staff.role == 'lecturer' && staff.departmentId == p.departmentId && p.supervisorId == request.auth.uid; }
  function stepValue(s) { let days=s.days; let name=s.name; return s == {'name':name,'days':days} && text(name,100) && days is int && days >= 0 && days <= 730; }
  function step(steps,i) { return steps.size() <= i || stepValue(steps[i]); }
  function validSteps(steps) { return steps is list && steps.size() >= 1 && steps.size() <= 10 && step(steps,0) && step(steps,1) && step(steps,2) && step(steps,3) && step(steps,4) && step(steps,5) && step(steps,6) && step(steps,7) && step(steps,8) && step(steps,9); }
  function validMilestone(m) { return m.keys().hasOnly(['name','dueDate','status','note']) && text(m.name,100) && m.dueDate is string && m.dueDate.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') && m.status in ['Not started','In progress','Under review','Completed','Delayed'] && m.note is string && m.note.size() <= 2000; }
  function initialValue(m,name) { return m == {'name':name,'dueDate':m.dueDate,'status':'Not started','note':''} && m.dueDate.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'); }
  function initialStep(p,i) { return p.milestonePlan.size() <= i || initialValue(p.milestones['m'+string(i)],p.milestonePlan[i].name); }
  function initialMilestones(p) { return p.milestones is map && p.milestones.size() == p.milestonePlan.size() && initialStep(p,0) && initialStep(p,1) && initialStep(p,2) && initialStep(p,3) && initialStep(p,4) && initialStep(p,5) && initialStep(p,6) && initialStep(p,7) && initialStep(p,8) && initialStep(p,9); }
  function folderCreate() {
   let p=request.resource.data;
   return primary(resource.data) && !resource.data.keys().hasAny(['folderCreatedAt','completedDate']) && !(resource.data.get('releaseState','') in ['Pending','Withheld'])
    && p.diff(resource.data).affectedKeys().hasOnly(['folderCreatedAt','folderCreatedBy','updatedBy','updatedAt'])
    && p.folderCreatedAt == request.time && p.folderCreatedBy == request.auth.uid && p.updatedBy == request.auth.uid && p.updatedAt == request.time;
  }
  function topicChange(id) {
   let p=request.resource.data;
   let e=getAfter(/databases/$(database)/documents/projects/$(id)/topicHistory/$(p.lastTopicEventId)).data;
   return resource.data.get('releaseState','') != 'Withheld' && primary(resource.data) && resource.data.get('topicDecision','Awaiting topic') != 'Approved'
    && p.diff(resource.data).affectedKeys().hasOnly(['title','abstract','topicDecision','decisionNote','topicApprovedBy','topicApprovedAt','templateId','milestonePlan','milestones','status','updatedBy','updatedAt','lastSupervisorUpdateAt','lastTopicEventId'])
    && text(p.title,300) && p.abstract is string && p.abstract.size() <= 3000 && p.topicDecision in ['Approved','Rejected','Changes requested'] && p.decisionNote is string && p.decisionNote.size() <= 2000 && (p.topicDecision == 'Approved' || text(p.decisionNote,2000))
    && p.updatedBy == request.auth.uid && p.updatedAt == request.time && p.lastSupervisorUpdateAt == request.time && text(p.lastTopicEventId,128) && e.actorId == request.auth.uid && e.createdAt == request.time
    && ((p.topicDecision == 'Approved' && p.status == 'Research in progress' && p.topicApprovedBy == request.auth.uid && p.topicApprovedAt == request.time
      && p.templateId == resource.data.departmentId + '__' + get(studentPath(id)).data.programme.upper().replace('[^A-Z0-9]','')
      && p.milestonePlan == get(/databases/$(database)/documents/milestoneTemplates/$(p.templateId)).data.steps && initialMilestones(p))
      || (p.topicDecision != 'Approved' && p.status == p.topicDecision && p.topicApprovedBy == '' && p.topicApprovedAt == null && p.templateId == '' && p.milestonePlan == [] && p.milestones == {}));
  }
  function topicRevision(id) {
   let p=request.resource.data;
   let e=getAfter(/databases/$(database)/documents/projects/$(id)/topicHistory/$(p.lastTopicEventId)).data;
   return primary(resource.data) && resource.data.topicDecision == 'Approved' && !resource.data.get('defenceCleared',false) && !(resource.data.get('releaseState','') in ['Pending','Withheld'])
    && p.diff(resource.data).affectedKeys().hasOnly(['title','abstract','decisionNote','topicApprovedBy','topicApprovedAt','lastSupervisorUpdateAt','lastTopicEventId','updatedBy','updatedAt'])
    && (p.title != resource.data.title || p.abstract != resource.data.abstract) && text(p.title,300) && p.abstract is string && p.abstract.size() <= 3000
    && text(p.decisionNote,2000) && p.topicApprovedBy == request.auth.uid && p.topicApprovedAt == request.time && p.lastSupervisorUpdateAt == request.time
    && p.updatedBy == request.auth.uid && p.updatedAt == request.time && !exists(/databases/$(database)/documents/projects/$(id)/topicHistory/$(p.lastTopicEventId)) && e.actorId == request.auth.uid && e.createdAt == request.time;
  }
  function ethicsPath(id) { return /databases/$(database)/documents/projects/$(id)/ethics/current; }
  function ethicsPolicyPath(dept) { return /databases/$(database)/documents/ethicsPolicies/$(dept); }
  function ethicsReady(id) { return exists(ethicsPath(id)) && ((getAfter(ethicsPath(id)).data.humanParticipants == false && getAfter(ethicsPath(id)).data.status == 'Not required') || (getAfter(ethicsPath(id)).data.humanParticipants == true && getAfter(ethicsPath(id)).data.status == 'Cleared')); }
  function ethicsGate(id,p,key,status) { return status == p.milestones[key].status || status == 'Not started' || !exists(ethicsPolicyPath(p.departmentId)) || get(ethicsPolicyPath(p.departmentId)).data.required == false || !(p.milestones[key].name.trim().lower() in get(ethicsPolicyPath(p.departmentId)).data.stages) || ethicsReady(id); }
  function progressChange(id) {
   let p=request.resource.data;
   let key=p.lastMilestoneKey;
   let e=getAfter(/databases/$(database)/documents/projects/$(id)/progressHistory/$(p.lastProgressEventId)).data;
   return resource.data.get('releaseState','') != 'Withheld' && primary(resource.data) && resource.data.topicDecision == 'Approved'
    && p.diff(resource.data).affectedKeys().hasOnly(['milestones','lastMilestoneKey','lastProgressEventId','lastSupervisorUpdateAt','updatedBy','updatedAt'])
    && key in resource.data.milestones && p.milestones.diff(resource.data.milestones).affectedKeys().hasOnly([key]) && p.milestones.size() == resource.data.milestones.size()
    && validMilestone(p.milestones[key]) && p.milestones[key].name == resource.data.milestones[key].name && ethicsGate(id,resource.data,key,p.milestones[key].status)
    && p.updatedBy == request.auth.uid && p.updatedAt == request.time && p.lastSupervisorUpdateAt == request.time && text(p.lastProgressEventId,128) && e.actorId == request.auth.uid && e.createdAt == request.time;
  }
  function rubricCriterion(c) { return c.keys().hasOnly(['name','maximum']) && c.name is string && c.name.trim().size() > 0 && c.name.size() <= 100 && c.maximum is int && c.maximum >= 1 && c.maximum <= 100; }
  function rubricItem(cs,i) { return cs.size() <= i || rubricCriterion(cs[i]); }
  function rubricDistinct(cs,i) { return cs.size() <= i || (cs[i].name.trim().lower() != cs[0].name.trim().lower() && (i <= 1 || cs[i].name.trim().lower() != cs[1].name.trim().lower()) && (i <= 2 || cs[i].name.trim().lower() != cs[2].name.trim().lower()) && (i <= 3 || cs[i].name.trim().lower() != cs[3].name.trim().lower())); }
  function rubricValid(cs) { return cs is list && cs.size() >= 1 && cs.size() <= 5 && rubricItem(cs,0) && rubricItem(cs,1) && rubricItem(cs,2) && rubricItem(cs,3) && rubricItem(cs,4) && rubricDistinct(cs,1) && rubricDistinct(cs,2) && rubricDistinct(cs,3) && rubricDistinct(cs,4); }
  function scoreItem(cs,ss,i) { return cs.size() <= i || (ss[i] is int && ss[i] >= 0 && ss[i] <= cs[i].maximum); }
  function feedbackWriter(p) { let s=get(self()).data; return signedIn() && s.active == true && s.role == 'lecturer' && s.departmentId == p.departmentId && (p.supervisorId == request.auth.uid || p.get('coSupervisorId','') == request.auth.uid) && !p.keys().hasAny(['completedDate']) && p.get('releaseState','') != 'Withheld'; }
  function validFeedback(f,p) { return f.keys().hasOnly(['category','priority','milestoneKey','milestoneName','comment','summary','actorId','actorName','createdAt'])
   && f.category in ['Content','Methodology','Referencing','Language','Formatting'] && f.priority in ['Action required','Suggestion','Positive feedback']
   && f.comment is string && f.comment.trim().size() > 0 && f.comment.size() <= 2000 && f.summary is string && f.summary.size() <= 2000
   && f.milestoneKey is string && ((f.milestoneKey == '' && f.milestoneName == 'Overall project') || (f.milestoneKey in p.get('milestones',{}) && f.milestoneName == p.milestones[f.milestoneKey].name))
   && f.actorId == request.auth.uid && f.actorName == get(self()).data.displayName && f.createdAt == request.time; }
  function feedbackChange(id) { let p=request.resource.data; let f=getAfter(/databases/$(database)/documents/projects/$(id)/feedback/$(p.lastFeedbackEventId)).data;
   return feedbackWriter(resource.data) && p.diff(resource.data).affectedKeys().hasOnly(['lastFeedbackEventId','lastFeedbackBy','lastFeedbackAt','updatedBy','updatedAt'])
    && text(p.lastFeedbackEventId,128) && p.lastFeedbackBy == request.auth.uid && p.lastFeedbackAt == request.time && p.updatedBy == request.auth.uid && p.updatedAt == request.time && validFeedback(f,resource.data); }
  function defenceChange(id) { let p=request.resource.data; let e=getAfter(/databases/$(database)/documents/projects/$(id)/defenceHistory/$(p.lastDefenceEventId)).data;
