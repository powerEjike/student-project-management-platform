{
  "name": "projecttrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pdf-assets.mjs --dev && vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/copy-pdf-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-projecttrack --only firestore \"node --test tests/firestore.integration.mjs\"",
    "staff": "node scripts/provision-staff.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^14.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
